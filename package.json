{
  "name": "olivias-agent-switch",
  "version": "0.2.18",
  "private": true,
  "type": "module",
  "description": "Olivia's local-first agent switchboard with Obsidian as the source of truth.",
  "scripts": {
    "start": "node src/server.mjs",
    "codex:live": "node --watch scripts/start-codex-dashboard.mjs",
    "desktop": "electron .",
    "build:windows": "electron-builder --win zip --x64 --publish never",
    "build:mac": "electron-builder --mac zip --publish never",
    "mcp": "node src/mcp.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/server.mjs && node --check src/mcp.mjs && node --check src/orchestrator.mjs && node --check public/app.js && node --check vscode-extension/extension.js && node --check vscode-extension/agentos-chat.cjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "@open-multi-agent/core": "^1.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.olivia.agent-switch",
    "productName": "Olivia's Agent Switch",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "!desktop/desktop/**",
      "!src/src/**",
      "!public/public/**",
      "package.json",
      "!**/*.test.mjs",
      "!**/data/**",
      "!**/vault/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "zip"
    },
    "win": {
      "target": "zip"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
